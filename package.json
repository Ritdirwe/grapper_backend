{
  "name": "gripper-backend",
  "version": "1.0.0",
  "description": "Gripper Marketplace Backend - NestJS with DDD Architecture",
  "main": "dist/main",
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && nest build && node scripts/generate-swagger-from-dist.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typeorm": "ts-node -r ./tsconfig-paths-bootstrap.js ./node_modules/typeorm/cli.js",
    "migration:generate": "pnpm typeorm migration:generate -d src/infrastructure/database/data-source.ts",
    "migration:create": "pnpm typeorm migration:create",
    "migration:run": "pnpm typeorm migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "pnpm typeorm migration:revert -d src/infrastructure/database/data-source.ts",
    "schema:sync": "pnpm typeorm schema:sync -d src/infrastructure/database/data-source.ts",
    "schema:drop": "pnpm typeorm schema:drop -d src/infrastructure/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeder.ts",
    "api:pass:a": "node scripts/api-reachability.js",
    "api:pass:a:start": "node scripts/api-reachability.js --start",
    "api:pass:b": "node scripts/api-happy-path.js",
    "api:pass:b:start": "node scripts/api-happy-path.js --start",
    "arch:check": "node scripts/check-boundaries.js",
    "arch:status": "node scripts/migration-status.js"
  },
  "keywords": [
    "nestjs",
    "ddd",
    "marketplace",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.968.0",
    "@aws-sdk/s3-request-presigner": "^3.968.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^9.0.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/platform-fastify": "^11.1.11",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "^0.44.0",
    "axios": "^1.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "handlebars": "^4.7.8",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "~0.2.2",
    "resend": "^6.9.2",
    "rxjs": "^7.8.2",
    "stripe": "^20.1.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.4",
    "@types/passport-jwt": "^4.0.1",
    "dotenv": "^17.2.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
