NODE_ENV=development
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=
DATABASE_URL=

# Waitlist database (separate from the live app DB)
WAITLIST_DATABASE_HOST=localhost
WAITLIST_DATABASE_PORT=5432
WAITLIST_DATABASE_USER=postgres
WAITLIST_DATABASE_PASSWORD=postgres
WAITLIST_DATABASE_NAME=gripper_waitlist

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Auth
AUTH_SECRET=

# Payment Gateways
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_WEBHOOK_SECRET=
FLW_AUTH_URL=https://idp.flutterwave.com/realms/flutterwave/protocol/openid-connect/token
FLW_BASE_URL=https://developersandbox-api.flutterwave.com
FLW_CALLBACK_URL=

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Expo Push
EXPO_ACCESS_TOKEN=

# Booking
BOOKING_CORRECTION_FEE=0

# General callback / redirect (used by Paystack & Flutterwave)
PAYMENT_CALLBACK_URL=

# Stripe Webhook (for mobile SDK payment confirmation)
STRIPE_WEBHOOK_SECRET=whsec_

# Default payment gateway for mobile SDK (stripe | paystack | flutterwave)
DEFAULT_PAYMENT_GATEWAY=flutterwave


# App
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4000
BACKEND_URL=http://localhost:3000
API_URL=https://api.grapper.net
ENABLE_CONFIG_VALIDATION=false

# Storage
STORAGE_PROVIDER=local
# STORAGE_DRIVER=s3 # legacy alias
UPLOAD_DIR=uploads
STORAGE_LOCAL_BASE_URL=
MAX_FILE_SIZE=5242880
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=grapper-uploads
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
AWS_S3_PUBLIC_URL=
AWS_S3_SIGNED_URL_EXPIRES_IN=3600

# Redis (optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email/SMTP Configuration
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=
MAIL_FROM_NAME=Grapper Marketplace
MAIL_FROM_ADDRESS=noreply@grapper.com

# Resend Configuration
RESEND_API_KEY=
RESEND_MAIL_API=

# Mailtrap API Configuration
MAILTRAP_API_TOKEN=
MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
